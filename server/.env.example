# Supabase PostgreSQL connection string (server-side only, never exposed to frontend)
# Use the "Connection pooling" URI from Supabase for DATABASE_URL (pgbouncer, port 6543)
# and the direct connection URI for DIRECT_URL (Prisma requires both to be set,
# even though this project provisions the schema via database/schema.sql, not
# `prisma migrate`).
# connection_limit: Sets max concurrent connections to the pooler. For development,
# a value of 5-10 is recommended to handle concurrent requests while avoiding pooler
# exhaustion. For production, adjust based on your Supabase plan and expected load.
# Supabase free tier typically has ~10-20 pooler connections available.
# pool_timeout/connect_timeout: Time (ms) to wait for a connection. Increase if your
# database region is geographically distant from the server.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=25&pool_timeout=20&connect_timeout=30"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Server
NODE_ENV=development
PORT=4000

# Frontend origin allowed to call this API with credentials
CORS_ORIGIN=http://localhost:5173

# Session cookie signing secret - generate with `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-value
SESSION_TTL_HOURS=12
COOKIE_NAME=tms_session

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Timezone used to display/interpret timestamps in the app
APP_TIMEZONE=Asia/Karachi

# Used only by prisma/seed.js to create the first Super Admin account
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
SUPER_ADMIN_NAME="Super Admin"
