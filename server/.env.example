# Supabase PostgreSQL connection string (server-side only, never exposed to frontend)
# Use the "Connection pooling" URI from Supabase for DATABASE_URL (pgbouncer, port 6543)
# and the direct connection URI for DIRECT_URL (used only by Prisma Migrate).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Server
NODE_ENV=development
PORT=4000

# Frontend origin allowed to call this API with credentials
CORS_ORIGIN=http://localhost:5173

# Session cookie signing secret - generate with `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-value
SESSION_TTL_HOURS=12
COOKIE_NAME=tms_session

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Timezone used to display/interpret timestamps in the app
APP_TIMEZONE=Asia/Karachi

# Used only by prisma/seed.js to create the first Super Admin account
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeThisPassword123!
SUPER_ADMIN_NAME="Super Admin"
